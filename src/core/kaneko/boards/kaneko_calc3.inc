static inline uint8_t calc3_rotate_bits(uint8_t dat, int bits)
{
	return (uint8_t)((dat << (bits & 7)) | (dat >> (8 - (bits & 7))));
}

static void c3_write_byte(uint32_t a, uint8_t v) { m68k_write_memory_8(a & 0xffffff, v); }
static void c3_write_word(uint32_t a, uint16_t v) { m68k_write_memory_16(a & 0xffffff, v); }
static uint16_t c3_read_word(uint32_t a) { return (uint16_t)m68k_read_memory_16(a & 0xffffff); }

// decompress_table (scan: the initial scan, nothing written)
static int calc3_decompress(int tabnum, int scan, int dstoffset)
{
	const uint8_t *datarom = s_calc3_rom;
	uint16_t length;
	int local_counter = 0;
	int offset = 0;
	const uint8_t numregions = datarom[offset + 0];
	if (tabnum > numregions)
		return 0;
	datarom++;
	for (int x = 0; x < tabnum; x++) {
		const uint8_t blocksize_offset = datarom[offset + 0];
		offset += blocksize_offset + 1;
		length = (uint16_t)(datarom[offset + 0] | (datarom[offset + 1] << 8));
		offset += length + 2;
	}
	uint16_t inline_table_base = 0, inline_table_size = 0;
	b.c3.database = (uint16_t)offset;
	b.c3.blocksize_offset = datarom[offset + 0];
	b.c3.mode = datarom[offset + 1];
	b.c3.alternateswaps = datarom[offset + 2];
	b.c3.shift = (uint8_t)((b.c3.alternateswaps & 0xf0) >> 4);
	b.c3.subtracttype = (uint8_t)(b.c3.alternateswaps & 0x03);
	b.c3.alternateswaps = (uint8_t)((b.c3.alternateswaps & 0x0c) >> 2);
	b.c3.decryption_key_byte = datarom[offset + 3];
	if (b.c3.blocksize_offset > 3) {
		inline_table_base = (uint16_t)(offset + 4);
		inline_table_size = (uint16_t)(b.c3.blocksize_offset - 3);
	}
	offset += b.c3.blocksize_offset + 1;
	length = (uint16_t)(datarom[offset + 0] | (datarom[offset + 1] << 8));
	offset += 2;
	if (length == 0) {
		if (b.c3.mode == 0x06)
			b.c3.writeaddress_current = 0x202000;
		else if (b.c3.mode == 0x08 && !scan) {   // (save to the EEPROM)
			for (int i = 0; i < 0x40; i++)
				s_eeprom.data[i] = c3_read_word(b.c3.eeprom_addr + 0x200000u + 2u * (uint32_t)i);
			s_eeprom.dirty = 1;
		}
		return 0;
	}
	if (inline_table_size) {
		static const uint8_t extra[] = { 0x14,0xf0,0xf8,0xd2,0xbe,0xfc,0xac,0x86,0x64,0x08,0x0c,0x74,0xd6,0x6a,0x24,0x12,0x1a,0x72,0xba,0x48,0x76,0x66,0x4a,0x7c,0x5c,0x82,0x0a,0x86,0x82,0x02,0xe6 };
		static const uint8_t extra2[] = { 0x2f,0x04,0xd1,0x69,0xad,0xeb,0x10,0x95,0xb0,0x2f,0x0a,0x83,0x7d,0x4e,0x2a,0x07,0x89,0x52,0xca,0x41,0xf1,0x4f,0xaf,0x1c,0x01,0xe9,0x89,0xd2,0xaf,0xcd };
		for (int i = 0; i < length; i++) {
			uint8_t dat = 0;
			const int im = i % inline_table_size;
			if (b.c3.subtracttype == 3 && b.c3.alternateswaps == 0) {   // (Shogun Warriors' table 0x40)
				const uint8_t inlinet = datarom[inline_table_base + im];
				dat = (uint8_t)(datarom[offset + i] - inlinet);
				if (!(im & 1))
					dat = (uint8_t)(dat - extra[im >> 1]);
			} else if (!((i / inline_table_size) & 1)) {
				if (im & 1) {
					const uint8_t inlinet = datarom[inline_table_base + im];
					dat = (uint8_t)(datarom[offset + i] - inlinet);
					dat = calc3_rotate_bits(dat, b.c3.shift);
				} else {
					const uint8_t inlinet = datarom[inline_table_base + im];
					dat = datarom[offset + i];
					if (b.c3.subtracttype != 0x02)
						dat = (uint8_t)(dat - inlinet - extra[im >> 1]);
					else
						dat = (uint8_t)(dat + inlinet + extra[im >> 1]);
					dat = calc3_rotate_bits(dat, 8 - b.c3.shift);
				}
			} else {
				if (!(im & 1)) {
					const uint8_t inlinet = datarom[inline_table_base + im];
					dat = (uint8_t)(datarom[offset + i] - inlinet);
					dat = calc3_rotate_bits(dat, b.c3.shift);
				} else {
					dat = datarom[offset + i];
					if (b.c3.subtracttype != 0x02)
						dat = (uint8_t)(dat - extra2[im >> 1]);
					else
						dat = (uint8_t)(dat + extra2[im >> 1]);
					dat = calc3_rotate_bits(dat, 8 - b.c3.shift);
				}
			}
			if (local_counter > 1) {
				if (!scan)
					c3_write_byte((uint32_t)(dstoffset + i), dat);
			} else
				b.c3.data_header[local_counter] = dat;
			++local_counter;
		}
	} else {
		const int16_t *key = f_calc3_keydata[b.c3.decryption_key_byte];
		if (key[0] == -1)
			return 0;   // (MAME: a fatal error, invalid decryption data)
		for (int i = 0; i < length; i++) {
			uint8_t dat = datarom[offset + i];
			const uint8_t keydat = (uint8_t)key[i & 0x3f];
			if (b.c3.subtracttype == 1)
				dat = (uint8_t)((i & 1) ? dat + keydat : dat - keydat);
			else if (b.c3.subtracttype == 2)
				dat = (uint8_t)(!(i & 1) ? dat + keydat : dat - keydat);
			else if (b.c3.subtracttype == 3)
				dat = (uint8_t)(dat - keydat);
			if (b.c3.alternateswaps == 1)
				dat = calc3_rotate_bits(dat, 8 - b.c3.shift);
			else if (b.c3.alternateswaps == 2)
				dat = calc3_rotate_bits(dat, b.c3.shift);
			else
				dat = !(i & 1) ? calc3_rotate_bits(dat, 8 - b.c3.shift) : calc3_rotate_bits(dat, b.c3.shift);
			if (local_counter > 1) {
				if (!scan)
					c3_write_byte((uint32_t)(dstoffset + i), dat);
			} else
				b.c3.data_header[local_counter] = dat;
			++local_counter;
		}
	}
	b.c3.dataend = (uint16_t)(offset + length + 1);
	return length;
}

static void calc3_init_crc(void)
{
	s_calc3_crc = 0;
	for (int x = 0; x < 0x20000; x++)
		s_calc3_crc = (uint16_t)(s_calc3_crc + s_calc3_rom[x]);
}

// mcu_run (each 1 / 59.1854 s from the reset)
static void calc3_run(void)
{
	if (b.c3.status != (1 | 2 | 4 | 8))
		return;
	if (b.c3.dsw_addr)
		c3_write_byte(b.c3.dsw_addr + 0x200000u, (uint8_t)(~rbx_port_read(s_port_dsw1) & 0xff));
	const uint16_t mcu_command = b.mcuram[(b.c3.command_offset / 2) & 0x7fff];
	if (mcu_command == 0)
		return;
	if (mcu_command == 0xff) {   // the 'init' command
		b.mcuram[(b.c3.command_offset >> 1) & 0x7fff] = 0;
		b.c3.dsw_addr = b.mcuram[1];
		b.c3.eeprom_addr = b.mcuram[2];
		b.c3.command_offset = b.mcuram[3];
		b.c3.poll_addr = b.mcuram[4];
		b.c3.checksumaddress = b.mcuram[5];
		b.c3.writeaddress = (uint32_t)b.mcuram[6] << 16 | b.mcuram[7];
		b.c3.writeaddress_current = b.c3.writeaddress;
		b.mcuram[(b.c3.checksumaddress / 2) & 0x7fff] = s_calc3_crc;
		for (int i = 0; i < 0x40; i++)
			c3_write_word(b.c3.eeprom_addr + 0x200000u + 2u * (uint32_t)i, s_eeprom.data[i]);
	} else {   // the number of transfers to make
		const int num_transfers = mcu_command;
		b.mcuram[(b.c3.command_offset >> 1) & 0x7fff] = 0;
		for (int i = 0; i < num_transfers; i++) {
			const int param1 = b.mcuram[((b.c3.command_offset >> 1) + 1 + 2 * i) & 0x7fff];
			const int param2 = b.mcuram[((b.c3.command_offset >> 1) + 2 + 2 * i) & 0x7fff];
			const uint8_t commandtabl = (uint8_t)((param1 & 0xff00) >> 8);
			const uint16_t commandaddr = (uint16_t)param2;
			const uint8_t commandunk = (uint8_t)(param1 & 0x00ff);
			const int length = calc3_decompress(commandtabl, 0, (int)b.c3.writeaddress_current - 2);
			if (length) {
				int write = commandaddr;
				c3_write_byte((uint32_t)write + 0x200000u, (uint8_t)b.c3.data_header[0]);
				c3_write_byte((uint32_t)write + 0x200001u, (uint8_t)b.c3.data_header[1]);
				write = commandaddr + (int8_t)commandunk;
				c3_write_word((uint32_t)write + 0x200000u, (uint16_t)(b.c3.writeaddress_current >> 16));
				c3_write_word((uint32_t)write + 0x200002u, (uint16_t)b.c3.writeaddress_current);
				b.c3.writeaddress_current += (uint32_t)((length + 3) & ~1);
			}
		}
	}
}
