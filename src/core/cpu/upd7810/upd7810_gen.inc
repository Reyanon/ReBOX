static void RLD(void)
{
	uint8_t m = RM( HL ), tmp;
	tmp = (m << 4) | (A & 0x0f);
	A = (A & 0xf0) | (m >> 4);
	WM( HL, tmp );
}

static void RRD(void)
{
	uint8_t m = RM( HL ), tmp;
	tmp = (A << 4) | (m >> 4);
	A = (A & 0xf0) | (m & 0x0f);
	WM( HL, tmp );
}

static void NEGA(void)
{
	A = ~A + 1;
}

static void HLT(void)
{
	m_halt = 1;
}

static void DIV_A(void)
{
	if (A)
	{
		uint8_t remainder;
		remainder = EA % A;
		EA /= A;
		A = remainder;
	}
	else
	{
		A = EAL;
		EA = 0xffff;
	}
}

static void DIV_B(void)
{
