		uint8_t remainder;
		remainder = EA % B;
		EA /= B;
		B = remainder;
	}
	else
	{
		B = EAL;
		EA = 0xffff;
	}
}

static void DIV_C(void)
{
	if (C)
	{
		uint8_t remainder;
		remainder = EA % C;
		EA /= C;
		C = remainder;
	}
	else
	{
		C = EAL;
		EA = 0xffff;
	}
}

