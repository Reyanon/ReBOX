{
	EA = A * C;
}

static void RLR_A(void)
{
	uint8_t carry=(PSW&CY)<<7;
	PSW = (PSW & ~CY) | (A & CY);
	A = (A >> 1) | carry;
}

static void RLR_B(void)
{
	uint8_t carry=(PSW&CY)<<7;
	PSW = (PSW & ~CY) | (B & CY);
	B = (B >> 1) | carry;
