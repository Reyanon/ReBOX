static void execute_set_input(int irqline, int state)
{
	switch (irqline) {
	case UPD7810_NMI:
		/* NMI is falling edge sensitive */
		if ( m_nmi == CLEAR_LINE && state == ASSERT_LINE )
			IRR |= INTFNMI;

		m_nmi = state;
		break;
	case UPD7810_INTF1:
		/* INT1 is rising edge sensitive */
		if ( m_int1 == CLEAR_LINE && state == ASSERT_LINE )
			IRR |= INTF1;

		m_int1 = state;
		break;
	case UPD7810_INTF2:
		/* INT2 is falling edge sensitive */
		/* we store the physical state (inverse of the logical state) */
		/* to keep the handling of port C consistent with the upd7801 */
		if ( (!m_int2) == CLEAR_LINE && state == ASSERT_LINE )
			IRR |= INTF2;

		m_int2 = !state;
		break;
	default:
		UPD_LOG("upd7810_set_irq_line invalid irq line #%d\n", irqline);
		break;
	}
	/* resetting interrupt requests is done with the SKIT/SKNIT opcodes only! */
}

static void illegal2(void)
{
	UPD_LOG("uPD7810 '%s': illegal opcode %02x %02x at PC:%04x\n", "upd7810", OP, OP2, PC);
}

static void SLRC_A(void)
{
	PSW = (PSW & ~CY) | (A & CY);
	A >>= 1;
	SKIP_CY;
}

static void SLRC_B(void)
{
	PSW = (PSW & ~CY) | (B & CY);
	B >>= 1;
	SKIP_CY;
}

static void SLRC_C(void)
{
	PSW = (PSW & ~CY) | (C & CY);
	C >>= 1;
	SKIP_CY;
}

static void SLLC_A(void)
{
	PSW = (PSW & ~CY) | ((A >> 7) & CY);
	A <<= 1;
	SKIP_CY;
}

static void SLLC_B(void)
{
	PSW = (PSW & ~CY) | ((B >> 7) & CY);
	B <<= 1;
	SKIP_CY;
}

static void SLLC_C(void)
{
	PSW = (PSW & ~CY) | ((C >> 7) & CY);
	C <<= 1;
	SKIP_CY;
}

static void SK_NV(void)
{
	/* 48 skip never */
}

static void SK_CY(void)
{
	if (CY == (PSW & CY))
		PSW |= SK;
}

static void SK_HC(void)
{
	if (HC == (PSW & HC))
		PSW |= SK;
}

static void SK_Z(void)
{
	if (Z == (PSW & Z))
		PSW |= SK;
}

static void SKN_NV(void)
{
	/* skip not never -> skip always ;-) */
	PSW |= SK;
}

static void SKN_CY(void)
{
	if (0 == (PSW & CY))
		PSW |= SK;
}

static void SKN_HC(void)
{
	if (0 == (PSW & HC))
		PSW |= SK;
}

static void SKN_Z(void)
{
	if (0 == (PSW & Z))
		PSW |= SK;
}

