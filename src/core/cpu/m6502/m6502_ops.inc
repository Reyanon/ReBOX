static void op_brk_c_imp(m6502_t *c)
{
	if(c->irq_taken || c->nmi_pending) {
		RDA(c, c->pc);
	} else {
		RDA(c, c->pc);
	c->pc++;
	}
	WR(c, c->sp, c->pc >> 8);
	c->sp = set_l(c->sp, (uint8_t)(c->sp - 1));
	WR(c, c->sp, c->pc);
	c->sp = set_l(c->sp, (uint8_t)(c->sp - 1));
	WR(c, c->sp, c->irq_taken || c->nmi_pending ? c->p & ~F_B : c->p);
	c->sp = set_l(c->sp, (uint8_t)(c->sp - 1));
	if(c->irq_taken && c->nmi_pending) {
		(void)0;
		c->pc = RDA(c, 0xfffa);
		c->pc = set_h(c->pc, RDA(c, 0xfffb));
		c->nmi_pending = 0;
	} else {
		if(c->irq_taken)
			(void)0;
		c->pc = RDA(c, 0xfffe);
		c->pc = set_h(c->pc, RDA(c, 0xffff));
	}
	c->irq_taken = 0;
	c->p = (c->p | F_I) & ~F_D; // Do *not* move after the prefetch
	PREFETCH(c);
	c->inst_state = -1;
}

