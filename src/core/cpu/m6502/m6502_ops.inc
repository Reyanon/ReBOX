	PREFETCH(c);
	c->inst_state = -1;
}

static void op_brk_16_imp(m6502_t *c)
{
	// The 6502 bug when a nmi occurs in a brk is reproduced (case !irq_taken && nmi_pending)
	if(c->irq_taken) {
		RDA(c, c->pc);
	} else {
		RDA(c, c->pc);
		c->pc++;
	}
	WR(c, c->sp, c->pc >> 8);
	c->sp = set_l(c->sp, (uint8_t)(c->sp - 1));
	WR(c, c->sp, c->pc);
	c->sp = set_l(c->sp, (uint8_t)(c->sp - 1));
	WR(c, c->sp, c->irq_taken ? c->p & ~F_B : c->p);
	c->sp = set_l(c->sp, (uint8_t)(c->sp - 1));
	if(c->nmi_pending) {
		(void)0;
		c->pc = RDA(c, 0xfff7);
		c->pc = set_h(c->pc, RDA(c, 0xfff6));
		c->nmi_pending = 0;
	} else {
		if(c->irq_taken)
			(void)0;
		c->pc = RDA(c, 0xfff3);
		c->pc = set_h(c->pc, RDA(c, 0xfff2));
	}
	c->irq_taken = 0;
	c->p |= F_I; // Do *not* move after the prefetch
	PREFETCH(c);
	c->inst_state = -1;
}

